# Copy to .env.local — never commit secrets
#
# Admin: VITE_ADMIN_EMAIL and VITE_ADMIN_PHONE must match supabase/schema.sql
# public.is_admin() (email + last 10 digits of phone). After changing admin,
# update Vercel env vars AND run supabase/fix-admin-email.sql in Supabase.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_ADMIN_EMAIL=mentor@analystbychance.com
VITE_ADMIN_PHONE=+918109901136
# Cloudflare Turnstile (production OTP). Leave empty for local dev (direct Supabase OTP).
VITE_TURNSTILE_SITE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=...  # local only — for npm run sync-instruments
# TURNSTILE_SECRET_KEY=...       # Supabase Edge Function secret only (send-phone-otp)
#
# notify-new-user Edge Function (Supabase secrets only — not Vercel):
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_MESSAGING_SERVICE_SID=MG...
# ADMIN_NOTIFY_PHONE=+91XXXXXXXXXX
# ADMIN_NOTIFY_EMAIL=mentor@analystbychance.com
# NOTIFY_WEBHOOK_SECRET=...      # optional; match Database Webhook header
